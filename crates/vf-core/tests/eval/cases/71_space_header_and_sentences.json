    "quantity": {"abstain": "not_found"},
    "unit_price": {"abstain": "not_found"},
    "amount": {"abstain": "not_found"},
    "total": {"abstain": "not_found"},
    "issued": {"abstain": "not_found"},
    "name": {"abstain": "ambiguous", "hold": "no_delimiter", "candidate": "は楷書で記入してください"}
  }
}
