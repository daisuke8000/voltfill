    {"x": 60, "y": 172, "text": "発行日 2026年11月8日以前の請求書は無効です"},
    {"x": 60, "y": 196, "text": "氏名 は楷書で記入してください"}
  ],
  "form": {"fields": [
    {"id": "item", "label": "品名"},
    {"id": "quantity", "label": "数量", "type": "number"},
    {"id": "unit_price", "label": "単価", "type": "amount"},
    {"id": "amount", "label": "金額", "type": "amount"},
    {"id": "total", "label": "合計", "type": "amount"},
    {"id": "issued", "label": "発行日", "type": "date"},
    {"id": "name", "label": "氏名"}
  ]},
  "expect": {
