{
  "schema_version": 1,
  "fields": [
    {
      "id": "matches",
      "label": "All source runs matching the question",
      "output_type": "string_array",
      "pages": [
        1
      ],
      "questions": [
        {
          "id": "pick",
          "type": "choice",
          "instructions": "Choose one remaining original source run answering the question, including all relevant lines and conditions. Exclude item labels and unrelated items. Choose none only when no remaining run answers the question.",
          "input": {
            "modality": "text"
          },
          "candidate_source": {
            "kind": "text_spans",
            "none_option": "No remaining matching source run"
          }
        }
      ],
      "resolver": {
        "kind": "selected_candidates",
        "question_id": "pick",
        "max_selections": 8
      },
      "validators": [
        {
          "kind": "non_empty"
        }
      ]
    }
  ]
}
